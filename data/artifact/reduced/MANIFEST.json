{
  "schema_version": "1.0",
  "created_for": "Gleaner ISSTA 2026 reduced artifact acceptance increment",
  "scope": "Expected reduced outputs, reduced20 RCA evidence, TracePicker Dataset B cross-system reduced evidence, a deterministic 20-datapack selection manifest, and portable source sampler reports under data/artifact/reduced/rq1 used to regenerate reduced20 sampler summaries.",
  "notes": [
    "Gleaner Dataset A reduced mode uses 20 deterministic fault-balanced datapacks listed in configs/reduced/reduced20_datapacks.json.",
    "scripts/prepare_reduced_reports.sh regenerates output/rcabench-platform-v2/sampler_reports/gleaner_reduced20 from data/artifact/reduced/rq1/gleaner_source.detailed_perf.parquet.",
    "scripts/artifact/filter_rq2_reduced20.py filters previous per-datapack Nezha/ShapleyIQ/MicroRCA detailed RCA results to the same 20 datapacks and writes the committed reduced20 RCA evidence.",
    "scripts/run_rq1b_cross_system.sh generates lightweight TracePicker Dataset B cross-system evidence from raw five-system TracePicker CSV data when available.",
    "scripts/prepare_reduced_data.sh verifies file presence, byte size, and SHA-256 checksum; it does not download or synthesize raw datapack directories."
  ],
